# ── Supabase (wajib untuk produksi) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya untuk script provisioning admin / migration. Jangan pernah
# diekspos ke client dan jangan disimpan di Vercel runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Dipakai scripts/seed-admin.ts. Tidak dibutuhkan runtime aplikasi.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Cloudinary (wajib untuk upload produksi) ────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Storefront ──────────────────────────────────────────────────
# Format: 62 diikuti 8–15 digit. Contoh: 62859121494481
NEXT_PUBLIC_WHATSAPP_NUMBER=62859121494481
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mode demo lokal (jangan aktifkan di produksi) ──────────────
# Saat true, katalog memakai data lokal + admin login cookie lokal.
# Produksi wajib false / tidak diisi.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
DEMO_ADMIN_EMAIL=admin@prelovedsaerawatt.local
DEMO_ADMIN_PASSWORD=saerawatt123

# Secret opsional untuk cookie admin demo. Kalau kosong, diturunkan
# dari DEMO_ADMIN_PASSWORD. Jangan gunakan nilai default di produksi.
AUTH_SECRET=

# Opsional: rate limit terdistribusi
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
